DATABASE_URL=postgresql://user:password@host/database
RESIDENT_DATABASE_URL=postgresql://user:password@host/database
USERS_DATABASE_URL=postgresql://user:password@host/database
AGENTS_DATABASE_URL=postgresql://user:password@host/database

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=mailer@example.com
ZOHO_SMTP_APP_PASSWORD=replace-with-a-zoho-app-password
ZOHO_SMTP_FROM=mailer@example.com

# Max magic-link/password-reset emails per user per 5 minutes (src/lib/auth.ts). Default 3.
MAGIC_LINK_RATE_LIMIT_REQUESTS=3
